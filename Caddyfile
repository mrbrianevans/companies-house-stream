{$SITE_ADDRESS:companies.stream} {
        log

        handle {
                root * /client
	            encode zstd gzip
                try_files {path} {path}.html {path}index.html
                header Content-Security-Policy "default-src 'self' ;script-src 'self';img-src 'self' data:;worker-src 'self';style-src 'self' 'unsafe-inline' fonts.googleapis.com;manifest-src 'self';connect-src ws: 'self' fonts.googleapis.com fonts.gstatic.com;font-src fonts.google.com fonts.gstatic.com data:;base-uri 'none'"
                header /assets/* Cache-Control max-age=31536000,immutable
                file_server
        }

        handle /events {
                reverse_proxy api:3000
        }

        # API routes (REST + WebSockets); strips /events prefix for the backend
        handle_path /events/* {
                reverse_proxy api:3000
        }

        header -Via
}

# Official-shaped test Streaming API (Basic Auth session key = UUID from /test page).
# Set TEST_SITE_ADDRESS like SITE_ADDRESS (e.g. test.companies.stream, localhost:3001, :8443).
{$TEST_SITE_ADDRESS:test.companies.stream} {
        log
        header -Via
        reverse_proxy api:3000 {
                transport http {
                        compression off
                }
                flush_interval -1
        }
}
